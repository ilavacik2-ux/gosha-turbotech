# ==============================================================================
# GOSHATURBOTECH — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Скопируйте этот файл в .env и укажите ваши рабочие параметры:
#   cp .env.example .env
#
# ВНИМАНИЕ: Файл .env содержит секреты и добавлен в .gitignore.
# Никогда не передавайте рабочий .env в публичные репозитории!
# ==============================================================================

# 1. Среда выполнения (development / production)
# В режиме 'production':
#   - Отключается авто-перезагрузка (reload)
#   - Запрещаются небезопасные CORS-источники
#   - Включается строгая проверка токенов и заголовков
GTT_ENV=development

# 2. Сетевая привязка Uvicorn
# В локальной разработке: 0.0.0.0 (чтобы тестировать с телефона по Wi-Fi)
# В продакшене за Nginx/Caddy: СТРОГО 127.0.0.1 (чтобы бэкенд не был открыт наружу в обход прокси)
GTT_HOST=127.0.0.1
GTT_PORT=8000

# 3. Флаг обратного прокси (Nginx / Caddy / Cloudflare)
# При true сервер доверяет заголовкам X-Forwarded-For и X-Real-IP для правильного
# определения IP клиента в rate-limiter'е и аудит-логе.
GTT_BEHIND_PROXY=true

# 4. Суженная политика CORS (Cross-Origin Resource Sharing)
# Укажите через запятую только доверенные домены, с которых разрешены API-запросы.
# В продакшене НЕ ИСПОЛЬЗУЙТЕ wildcard (*)!
# Примеры:
# GTT_CORS_ALLOWED_ORIGINS=https://goshaturbotech.ru,https://www.goshaturbotech.ru,http://localhost:8000,http://127.0.0.1:8000
GTT_CORS_ALLOWED_ORIGINS=https://goshaturbotech.ru,https://www.goshaturbotech.ru,http://localhost:8000,http://127.0.0.1:8000

# 5. Скрытый шлюз админки (Stealth Gateway Token)
# Секретный токен доступа к скрытой панели управления (/admin?token=...).
# Любой запрос к /admin без этого токена возвращает чистый HTTP 404 (Not Found).
# Сгенерируйте сложную случайную строку (например: openssl rand -hex 24)
GTT_GATEWAY_TOKEN=gtt_atelier_2026_x71k

# 6. Учетные данные главного администратора
GTT_ADMIN_USERNAME=gosha
GTT_ADMIN_PASSWORD=gtt_master_password_2026!

# 7. Секретный ключ подписи сессий и куки (Session HMAC Key)
# Используется для криптографической подписи админских сессионных токенов
GTT_SECRET_KEY=gtt_secure_hmac_secret_key_prod_2026_change_me!

# 8. Защита от брутфорса (Rate Limiting & Lockout)
# Максимум неудачных попыток входа подряд с одного IP до временной блокировки
GTT_MAX_LOGIN_ATTEMPTS=5
# Длительность блокировки IP в минутах
GTT_LOCKOUT_MINUTES=15
# Общий глобальный лимит ошибок входа для активации прогрессивной задержки (delay penalty)
GTT_GLOBAL_BRUTE_LIMIT=10
GTT_GLOBAL_PENALTY_SECONDS=3

# 9. Интеграция с Telegram (Оповещения безопасности и заявки)
# Опционально: создайте бота через @BotFather и укажите токен и chat_id
GTT_TELEGRAM_BOT_TOKEN=
GTT_TELEGRAM_CHAT_ID=
