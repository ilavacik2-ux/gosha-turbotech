# ==============================================================================
# GOSHATURBOTECH — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Скопируйте этот файл в .env и задайте сгенерированные секреты:
#   cp .env.example .env
#
# ВНИМАНИЕ: Файл .env содержит секреты и добавлен в .gitignore.
# Никогда не передавайте рабочий .env в публичные репозитории!
# ==============================================================================

# 1. Среда выполнения (development / production)
GTT_ENV=production

# 2. Сетевая привязка Uvicorn
# В продакшене за Nginx/Caddy: СТРОГО 127.0.0.1
GTT_HOST=127.0.0.1
GTT_PORT=8000

# 3. Флаг обратного прокси (Nginx / Caddy / Cloudflare)
GTT_BEHIND_PROXY=true
GTT_TRUSTED_PROXIES=127.0.0.1,::1

# 4. Суженная политика CORS (Cross-Origin Resource Sharing)
GTT_CORS_ALLOWED_ORIGINS=https://goshaturbotech.ru,https://www.goshaturbotech.ru,http://localhost:8000,http://127.0.0.1:8000

# 5. Скрытый путь и токен-шлюз админки
# Секретный путь (можно сменить на любой, например /gtt-atelier)
GTT_ADMIN_PATH=/admin
# Начальный токен шлюза (openssl rand -hex 24). После настройки токен хранится и перевыпускается в SQLite.
GTT_GATEWAY_TOKEN=CHANGE_ME_GATEWAY_TOKEN_HEX_24

# 6. Учетные данные главного администратора
GTT_ADMIN_USERNAME=gosha
# Сильный пароль (сгенерируйте минимум 16 символов)
GTT_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# 7. Секретный ключ подписи HMAC куки (сгенерируйте: openssl rand -hex 32)
GTT_SECRET_KEY=CHANGE_ME_HMAC_SECRET_KEY_HEX_32

# 8. Защита от брутфорса (Rate Limiting & Lockout в SQLite)
GTT_MAX_LOGIN_ATTEMPTS=5
GTT_LOCKOUT_MINUTES=15
GTT_MAX_GATE_FAILS=12
GTT_GATE_LOCKOUT_MINUTES=30
