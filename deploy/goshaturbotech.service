# ==============================================================================
# GOSHATURBOTECH — SYSTEMD SERVICE UNIT (Linux / Ubuntu / Debian)
# ==============================================================================

[Unit]
Description=GoshaTurboTech Atelier Hub Backend (FastAPI / Uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/goshaturbotech
EnvironmentFile=/var/www/goshaturbotech/.env

ExecStart=/var/www/goshaturbotech/venv/bin/uvicorn server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips "127.0.0.1" \
    --no-access-log

Restart=always
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/goshaturbotech

StandardOutput=journal
StandardError=journal
SyslogIdentifier=goshaturbotech

[Install]
WantedBy=multi-user.target
